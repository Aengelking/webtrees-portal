node_modules/
dist/
.vite/

# The webtrees checkout the module's tests run against. No trailing slash: it
# is often a symlink to a checkout elsewhere, which a directory pattern misses.
module/.webtrees
module/.phpunit.cache/
module/portal_api/vendor/

# Wrangler / miniflare local state, including captured request traces.
portal/.wrangler/

# Playwright
portal/test-results/
portal/playwright-report/
portal/blob-report/
portal/.playwright/

# Pictures of the portal, taken by e2e/screenshots.spec.ts. The spec is kept;
# what it produces is a build artefact and belongs wherever it is being used.
portal/screenshots/

.DS_Store
*.log
.env
.env.local
.dev.vars
