<?xml version="1.0"?>
<phpunit
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.4/phpunit.xsd"
  bootstrap="tests/bootstrap.php"
  colors="true"
  cacheDirectory=".phpunit.cache"
  failOnWarning="true"
  failOnRisky="true"
>
  <!--
    `beStrictAboutOutputDuringTests` is deliberately off.

    The module reports what it cannot do with `error_log()` — a tree it cannot
    serve, an error it could not even record — and a dozen tests exercise those
    paths on purpose. PHPUnit 12, which webtrees 2.2.6 brings with it, counts
    those lines as output from the test and marks it risky; this suite fails on
    risky, so every one of them failed. The lines still go to a file rather
    than the console (see tests/bootstrap.php), and what a failure *records* is
    asserted against the module's own table, where it belongs.
  -->
  <testsuites>
    <testsuite name="portal_api">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory suffix=".php">portal_api/src</directory>
    </include>
  </source>
</phpunit>
