<?php

declare(strict_types=1);

use Engelking\Webtrees\PortalApi\PortalApiModule;
use Engelking\Webtrees\PortalApi\Services\SpouseMarker;
use Fisharebest\Webtrees\Http\RequestHandlers\ControlPanel;
use Fisharebest\Webtrees\Http\RequestHandlers\ModulesAllPage;
use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Registry;
use Fisharebest\Webtrees\Tree;

/**
 * @var array<int,array<string,mixed>> $rows
 * @var array<string,int>              $counts
 * @var bool                           $truncated
 * @var PortalApiModule                $module
 * @var Tree                           $tree
 * @var bool                           $may_mark
 * @var string                         $settings_url
 * @var string                         $title
 */

$suggestions = [];

foreach ($rows as $row) {
    if (($row['state'] === 'missing' || $row['state'] === 'wrong_way') && $row['suggestion'] !== null) {
        $suggestions[] = $row['suggestion'];
    }
}

?>

<?= view('components/breadcrumbs', ['links' => [route(ControlPanel::class) => I18N::translate('Control panel'), route(ModulesAllPage::class) => I18N::translate('Modules'), $settings_url => $module->title(), $title]]) ?>

<h1><?= e($title) ?></h1>

<p>
    <?= I18N::translate('Every couple in the family tree where both partners carry an archive number. Their children can only be filed under one of the two, so the other parent’s descent is invisible in the children’s numbers — and the relationship table below the module’s preferences is what makes it visible again.') ?>
</p>

<p>
    <?= I18N::translate('This matters more than it used to. A marriage the table does not know gives no warning: it makes the portal name a relationship that is too distant, confidently. A row that is there but written the wrong way round matches nobody and does the same.') ?>
</p>

<p>
    <strong><?= I18N::translate('This screen only reads.') ?></strong>
    <?= I18N::translate('Nothing here is written to the table — it stays what the family wrote. What is offered is the text to paste.') ?>
</p>

<?php
$unmarked = [];

// How many of those the records themselves decide — the ones with a button.
// Counted from the rows already on the screen so that the number on the
// button is the number in the table below it, and not a second scan's answer.
$decided = 0;

foreach ($rows as $row) {
    if ($row['state'] === 'unmarked' || $row['state'] === 'unmarked_stuck') {
        $unmarked[] = $row;

        if ($row['marks'] !== null) {
            ++$decided;
        }
    }
}
?>

<?php if ($truncated) : ?>
    <div class="alert alert-warning">
        <?= I18N::translate('The family tree is larger than this screen reads in one go, so the list below is not complete.') ?>
    </div>
<?php endif ?>

<div class="row mb-3">
    <?php foreach (['unmarked' => I18N::translate('Missing the “!”'), 'missing' => I18N::translate('Not in the table'), 'wrong_way' => I18N::translate('Written the wrong way round'), 'unclear' => I18N::translate('Cannot be read'), 'recorded' => I18N::translate('Already right')] as $state => $label) : ?>
        <?php $count = $state === 'unmarked' ? ($counts['unmarked'] ?? 0) + ($counts['unmarked_stuck'] ?? 0) : ($counts[$state] ?? 0) ?>
        <div class="col-6 col-md-3">
            <div class="border rounded p-3 text-center">
                <div class="fs-4"><?= e((string) $count) ?></div>
                <small class="text-muted"><?= e($label) ?></small>
            </div>
        </div>
    <?php endforeach ?>
</div>

<?php if ($unmarked !== []) : ?>
    <h2><?= I18N::translate('A couple sharing one number') ?></h2>

    <p>
        <?= I18N::translate('A partner who married into the family carries their spouse’s number with a “!” on the end. That mark is what keeps the two of them apart. Where it is missing both carry the same number, and every relationship either of them has is worked out as though the incomer descended from a line they are not in.') ?>
    </p>

    <p>
        <?= I18N::translate('Who the mark belongs to is read from the records: somebody who married in has no parents in the archive. Where that does not decide it, this says so and leaves it to a person — a “!” on the wrong one of the two does not fail, it quietly makes each of them the other.') ?>
    </p>

    <?php if ($may_mark && $decided > 0) : ?>
        <form method="post" class="mb-2">
            <?= csrf_field() ?>
            <input type="hidden" name="mark_all" value="1">
            <button
                type="submit"
                class="btn btn-primary"
                data-wt-confirm="<?= I18N::plural('Add the mark to one number?', 'Add the mark to %s numbers, in one go?', $decided, I18N::number($decided)) ?>"
            >
                <?= I18N::plural('Propose the mark for the one couple below that the records decide', 'Propose the mark for all %s couples below that the records decide', $decided, I18N::number($decided)) ?>
            </button>
        </form>

        <p class="text-muted">
            <?= I18N::translate('This leaves out the couples the records do not decide — those are still one at a time, and still yours to read.') ?>
            <?php if ($decided > SpouseMarker::MAX_AT_ONCE) : ?>
                <?= I18N::translate('There are more than one press can write, so it stops at %s and says how many are left.', I18N::number(SpouseMarker::MAX_AT_ONCE)) ?>
            <?php endif ?>
            <?= I18N::translate('If your account does not accept your own changes at once, this puts one entry per correction into the list of changes waiting for approval.') ?>
        </p>
    <?php endif ?>

    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th scope="col"><?= I18N::translate('Family') ?></th>
                    <th scope="col"><?= I18N::translate('Husband') ?></th>
                    <th scope="col"><?= I18N::translate('Wife') ?></th>
                    <th scope="col"><?= I18N::translate('Married in') ?></th>
                    <th scope="col"><span class="visually-hidden"><?= I18N::translate('Correction') ?></span></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($unmarked as $row) : ?>
                    <tr class="table-danger">
                        <td><?= e($row['xref']) ?></td>
                        <?php foreach (['husband', 'wife'] as $side) : ?>
                            <td>
                                <?= e($row[$side]['name']) ?>
                                <br>
                                <small class="text-muted font-monospace"><?= e((string) $row[$side]['number']) ?></small>
                            </td>
                        <?php endforeach ?>
                        <td>
                            <?php if ($row['marks'] === null) : ?>
                                <span class="text-muted"><?= I18N::translate('Cannot be read from the records') ?></span>
                            <?php else : ?>
                                <?= e($row['marks']['name']) ?>
                                <br>
                                <small class="font-monospace"><?= e($row['marks']['number'] . '!') ?></small>
                            <?php endif ?>
                        </td>
                        <td class="text-end">
                            <?php if ($row['marks'] !== null && $may_mark) : ?>
                                <form method="post">
                                    <?= csrf_field() ?>
                                    <input type="hidden" name="xref" value="<?= e($row['marks']['xref']) ?>">
                                    <input type="hidden" name="number" value="<?= e($row['marks']['number']) ?>">
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        <?= I18N::translate('Propose the mark') ?>
                                    </button>
                                </form>
                            <?php endif ?>
                        </td>
                    </tr>
                <?php endforeach ?>
            </tbody>
        </table>
    </div>

    <p class="text-muted">
        <?= I18N::translate('The correction is made the way any edit in webtrees is made: it is written to the list of changes, waiting to be approved — or applied at once, if your own account is set to accept your changes without asking. Either way it is logged, and webtrees’ list of changes can undo it.') ?>
    </p>
<?php endif ?>

<?php if ($suggestions !== []) : ?>
    <h2><?= I18N::translate('Rows to add') ?></h2>

    <p>
        <?= I18N::translate('Paste these into “%s” in the module’s preferences, then read them once before saving: a marriage the archive deliberately left out of the table is not a mistake this screen can see.', I18N::translate('Marriages inside the family')) ?>
    </p>

    <textarea class="form-control font-monospace" rows="<?= e((string) min(12, count($suggestions))) ?>" readonly><?= e(implode("\n", $suggestions)) ?></textarea>
<?php endif ?>

<h2 class="mt-4"><?= I18N::translate('What the family tree has') ?></h2>

<?php if ($rows === []) : ?>
    <div class="alert alert-info">
        <?= I18N::translate('No couple in this family tree has an archive number on both partners.') ?>
    </div>
<?php else : ?>
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th scope="col"><?= I18N::translate('Family') ?></th>
                    <th scope="col"><?= I18N::translate('Husband') ?></th>
                    <th scope="col"><?= I18N::translate('Wife') ?></th>
                    <th scope="col"><?= I18N::translate('Children filed under') ?></th>
                    <th scope="col"><?= I18N::translate('In the table') ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($rows as $row) : ?>
                    <tr<?= $row['state'] === 'missing' || $row['state'] === 'wrong_way' ? ' class="table-warning"' : '' ?>>
                        <td>
                            <?php $family = Registry::familyFactory()->make($row['xref'], $tree) ?>
                            <?php if ($family === null) : ?>
                                <?= e($row['xref']) ?>
                            <?php else : ?>
                                <a href="<?= e($family->url()) ?>"><?= e($row['xref']) ?></a>
                            <?php endif ?>
                        </td>
                        <?php foreach (['husband', 'wife'] as $side) : ?>
                            <td>
                                <?= e($row[$side]['name']) ?>
                                <br>
                                <small class="text-muted font-monospace"><?= e((string) $row[$side]['number']) ?></small>
                            </td>
                        <?php endforeach ?>
                        <td class="font-monospace">
                            <?= $row['filed_under'] === null
                                ? '<span class="text-muted">' . e(I18N::translate('No child carries a number')) . '</span>'
                                : e((string) $row['filed_under']) ?>
                        </td>
                        <td>
                            <?php if ($row['state'] === 'recorded') : ?>
                                <?= I18N::translate('Yes') ?>
                            <?php elseif ($row['state'] === 'wrong_way') : ?>
                                <strong><?= I18N::translate('The wrong way round') ?></strong>
                                <br>
                                <small class="font-monospace"><?= e((string) $row['suggestion']) ?></small>
                            <?php elseif ($row['state'] === 'missing') : ?>
                                <strong><?= I18N::translate('No') ?></strong>
                                <br>
                                <small class="font-monospace"><?= e((string) $row['suggestion']) ?></small>
                            <?php else : ?>
                                <span class="text-muted"><?= I18N::translate('Cannot be read') ?></span>
                            <?php endif ?>
                        </td>
                    </tr>
                <?php endforeach ?>
            </tbody>
        </table>
    </div>
<?php endif ?>

<p class="mt-4">
    <a class="btn btn-outline-secondary" href="<?= e($settings_url) ?>">
        <?= I18N::translate('back') ?>
    </a>
</p>
