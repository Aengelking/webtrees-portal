<?php

declare(strict_types=1);

use Engelking\Webtrees\PortalApi\PortalApiModule;
use Engelking\Webtrees\PortalApi\Services\Diagnosis;
use Engelking\Webtrees\PortalApi\Services\DiagnosisCheck;
use Fisharebest\Webtrees\Http\RequestHandlers\ControlPanel;
use Fisharebest\Webtrees\Http\RequestHandlers\ModulesAllPage;
use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Registry;
use Illuminate\Support\Collection;

/**
 * @var Collection<int,DiagnosisCheck> $checks
 * @var Collection<int,object>         $errors
 * @var PortalApiModule                $module
 * @var int                            $error_count
 * @var int                            $path_length
 * @var array<int,array{name:string,xref:string|null,numbers:array<int,string>}> $numbers
 * @var string                         $settings_url
 * @var string                         $title
 * @var string                         $worst
 */

$row_class = [
    Diagnosis::OK      => '',
    Diagnosis::WARNING => 'table-warning',
    Diagnosis::PROBLEM => 'table-danger',
];

$status_label = [
    Diagnosis::OK      => I18N::translate('OK'),
    Diagnosis::WARNING => I18N::translate('Worth a look'),
    Diagnosis::PROBLEM => I18N::translate('Problem'),
];

$summary = [
    Diagnosis::OK      => ['alert-success', I18N::translate('Everything the portal needs is in place.')],
    Diagnosis::WARNING => ['alert-warning', I18N::translate('The portal works, but something below is worth a look.')],
    Diagnosis::PROBLEM => ['alert-danger', I18N::translate('Something is wrong. The portal is not working properly for members.')],
];

?>

<?= view('components/breadcrumbs', ['links' => [route(ControlPanel::class) => I18N::translate('Control panel'), route(ModulesAllPage::class) => I18N::translate('Modules'), $settings_url => $module->title(), $title]]) ?>

<h1><?= e($title) ?></h1>

<div class="alert <?= e($summary[$worst][0]) ?>">
    <?= e($summary[$worst][1]) ?>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th scope="col"><?= I18N::translate('Check') ?></th>
                <th scope="col"><?= I18N::translate('Status') ?></th>
                <th scope="col"><?= I18N::translate('Found') ?></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($checks as $check) : ?>
                <tr class="<?= e($row_class[$check->status] ?? '') ?>">
                    <th scope="row"><?= e($check->label) ?></th>
                    <td><?= e($status_label[$check->status] ?? $check->status) ?></td>
                    <td>
                        <?= e($check->detail) ?>
                        <?php if ($check->advice !== '') : ?>
                            <div class="form-text"><?= e($check->advice) ?></div>
                        <?php endif ?>
                    </td>
                </tr>
            <?php endforeach ?>
        </tbody>
    </table>
</div>

<?php if ($path_length > 0) : ?>
    <h2 class="h5 mt-5"><?= I18N::translate('What members can see') ?></h2>

    <p>
        <?= I18N::translate('New accounts created by invitation are limited automatically. Accounts that already exist keep what they have until you apply it here.') ?>
    </p>

    <p class="text-muted">
        <?= I18N::translate('This changes what people who are already signed in can see, so it does not happen on its own. Deceased people are unaffected; only living people are hidden.') ?>
    </p>

    <form method="post" action="<?= e(route('module', ['module' => $module->name(), 'action' => 'AdminDiagnosis'])) ?>">
        <input type="hidden" name="diagnosis_action" value="apply_path_length">
        <button type="submit" class="btn btn-outline-primary">
            <?= I18N::plural('Limit every member account to %s step', 'Limit every member account to %s steps', $path_length, I18N::number($path_length)) ?>
        </button>
        <?= csrf_field() ?>
    </form>
<?php endif ?>

<h2 class="h5 mt-5"><?= I18N::translate('Numbers members can be found by') ?></h2>

<p>
    <?= I18N::translate('A member can connect with another by typing the reference number on their record — an “SB” number here. Three different reasons for “nobody was found under that number” look identical from the form, and this table tells them apart: somebody with no portal account is not in it at all, somebody who stayed out of the member directory is not in it either, and somebody listed with no number beside their name carries it somewhere other than a REFN fact.') ?>
</p>

<p class="form-text">
    <?= I18N::translate('The numbers are shown exactly as the search reads them, at a member’s access level — so a number hidden by a restriction notice is absent here too.') ?>
</p>

<?php if ($numbers === []) : ?>
    <p><?= I18N::translate('Nobody is visible in the member directory yet, so this search can find nobody. Members choose that for themselves, under “Einstellungen”.') ?></p>
<?php else : ?>
    <div class="table-responsive">
        <table class="table table-sm">
            <caption class="visually-hidden"><?= I18N::translate('Numbers members can be found by') ?></caption>
            <thead>
                <tr>
                    <th scope="col"><?= I18N::translate('Member') ?></th>
                    <th scope="col"><?= I18N::translate('Individual record') ?></th>
                    <th scope="col"><?= I18N::translate('Reference number') ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($numbers as $row) : ?>
                    <tr>
                        <td><?= e($row['name']) ?></td>
                        <td><?= $row['xref'] === null ? '<span class="text-danger">' . I18N::translate('No linked record') . '</span>' : e($row['xref']) ?></td>
                        <td>
                            <?php if ($row['numbers'] === []) : ?>
                                <span class="text-danger"><?= I18N::translate('None — this member cannot be found by number.') ?></span>
                            <?php else : ?>
                                <?= e(implode(' · ', $row['numbers'])) ?>
                            <?php endif ?>
                        </td>
                    </tr>
                <?php endforeach ?>
            </tbody>
        </table>
    </div>
<?php endif ?>

<h2 class="h5 mt-5"><?= I18N::translate('Recent errors') ?></h2>

<p>
    <?= I18N::translate('Requests that failed for a member. Each one shows the member a short reference; if somebody quotes one, look for it here.') ?>
</p>

<p class="text-muted">
    <?= I18N::translate('Only the endpoint and the error are recorded — never what was sent or asked for, because that would be somebody’s date of birth or whom they searched for. Entries are deleted after 30 days.') ?>
</p>

<?php if ($errors->isEmpty()) : ?>
    <p class="text-muted"><?= I18N::translate('Nothing has failed.') ?></p>
<?php else : ?>
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th scope="col"><?= I18N::translate('Reference') ?></th>
                    <th scope="col"><?= I18N::translate('When') ?></th>
                    <th scope="col"><?= I18N::translate('Endpoint') ?></th>
                    <th scope="col"><?= I18N::translate('Error') ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($errors as $error) : ?>
                    <tr>
                        <td><code><?= e($error->reference) ?></code></td>
                        <td><?= view('components/datetime', ['timestamp' => Registry::timestampFactory()->make((int) $error->occurred_at)]) ?></td>
                        <td><?= e((string) ($error->method ?? '')) ?> <?= e((string) ($error->route ?? '')) ?></td>
                        <td>
                            <?= e((string) ($error->error_class ?? '')) ?>
                            <div class="form-text">
                                <?= e((string) ($error->message ?? '')) ?>
                                <?php if (($error->file ?? '') !== '') : ?>
                                    <br><?= e((string) $error->file) ?>:<?= (int) $error->line ?>
                                <?php endif ?>
                            </div>
                        </td>
                    </tr>
                <?php endforeach ?>
            </tbody>
        </table>
    </div>

    <form method="post" action="<?= e(route('module', ['module' => $module->name(), 'action' => 'AdminDiagnosis'])) ?>">
        <input type="hidden" name="diagnosis_action" value="clear_errors">
        <button type="submit" class="btn btn-outline-danger">
            <?= I18N::plural('Clear the error log (%s entry)', 'Clear the error log (%s entries)', $error_count, I18N::number($error_count)) ?>
        </button>
        <?= csrf_field() ?>
    </form>
<?php endif ?>
