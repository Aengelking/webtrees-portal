{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webtrees-portal",
  "main": "edge/worker.ts",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // The SPA fallback. On Workers this replaces the `_redirects` rule
    // `/*  /index.html  200`, which the asset validator rejects: it normalises
    // `/index.html` back to `/`, which matches `/*` again, so the rule is a
    // loop by construction.
    "not_found_handling": "single-page-application",

    // Which paths reach the Worker at all.
    //
    // Without this, the fallback above answers *before the Worker runs*, so a
    // path listed nowhere here can never be handled in `edge/worker.ts` — it
    // gets index.html with a 200 on it, whatever the code says.
    //
    // `/api/*` is the obvious one: without it every API call would quietly
    // return HTML instead of JSON.
    //
    // `/.well-known/*` is here for a subtler reason. An MCP client that is
    // refused goes looking for OAuth metadata there, and the Worker answers
    // with a JSON 404 — see `noOAuthHere` in edge/proxy.ts. That answer was
    // written and then never reached, because this list did not mention the
    // path: the fix was live and dead at the same time, and the client went on
    // parsing a web page as JSON. The Worker passes anything it does not
    // recognise here — an ACME challenge, say — straight back to the assets.
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },

  "observability": {
    "enabled": true
  },

  // Settings.
  //
  // A plain "Text" variable added in the Cloudflare dashboard does NOT
  // survive: this file is the source of truth for plaintext vars, so the next
  // deploy — including an automatic Workers Build from a push to this repo —
  // removes anything not listed here. A dashboard-set WEBTREES_ORIGIN
  // therefore disappears on its own, seemingly at random, and the portal
  // starts answering 503 or redirecting somewhere unexpected long after
  // anybody touched the setting.
  //
  // So non-secret settings live here, in version control, where a deploy
  // cannot quietly take them away and a review can see them.
  //
  // PORTAL_PROXY_SECRET is a real secret and must never be committed.
  // Encrypted secrets are preserved across deploys, so set it once:
  //   npx wrangler secret put PORTAL_PROXY_SECRET
  "vars": {
    // **Exactly** the base_url in webtrees' config.ini.php — same scheme, same
    // host, same presence or absence of "www". Not merely a name that reaches
    // the same server.
    //
    // webtrees redirects anything else to its own canonical address, and the
    // proxy is deliberately built not to follow redirects
    // (`redirect: 'manual'` in edge/proxy.ts), so the 302 travels back to the
    // client instead. A browser survives that; a POST does not, which is how
    // this was found — an MCP client got a redirect where it expected an
    // answer, with nothing anywhere naming the missing "www." as the cause.
    "WEBTREES_ORIGIN": "https://www.sackstiftung.com"

    // WEBTREES_UGLY_URLS defaults to true, which is what a stock webtrees
    // needs. Set it to "false" only if URL rewriting is configured on the
    // server *and* rewrite_urls="1" is in config.ini.php. Getting it wrong is
    // visible either way: wrongly false gives a bare webserver 404, wrongly
    // true gives a 308 redirect to the pretty form.
  }
}
