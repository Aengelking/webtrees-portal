{
  "id": "/",
  "name": "Sack Familienapp",
  "short_name": "Sack",
  "description": "Das Mitgliederportal der Familie: eigenes Profil, Verwandtschaft, Mitgliederverzeichnis und Nachrichten.",
  "lang": "de",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f1f5f9",
  "theme_color": "#f1f5f9",
  "categories": ["lifestyle", "social"],

  "//": "The app names itself here so that navigator.getInstalledRelatedApps() can answer whether it is already on this device — the only way to know that from an ordinary tab, since display-mode only ever describes the window it is asked in. prefer_related_applications MUST stay false: true tells the browser to offer a store app instead, which would suppress the very install prompt this exists to support.",
  "prefer_related_applications": false,
  "related_applications": [
    { "platform": "webapp", "url": "/manifest.webmanifest" }
  ],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Nachrichten",
      "short_name": "Nachrichten",
      "url": "/messages",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Mitglieder",
      "short_name": "Mitglieder",
      "url": "/members",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
